{
  "name": "info-processing-quiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "sync-data": "python scripts/sync_public_exam_data.py",
    "convert-pdfs": "python scripts/convert_pdfs_to_exam_json.py",
    "validate-data": "python scripts/validate_exam_json.py",
    "build": "npm run sync-data && tsc -b && node scripts/run-vite-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "markdown-link-check": "^3.14.2",
    "markdownlint-cli2": "^0.23.1",
    "prettier": "^3.9.6",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "^7.3.6"
  }
}
